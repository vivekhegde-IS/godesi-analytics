# ============================================
# GoDesi Analytics: files git must ignore
# one pattern per line, no commas
# ============================================

# ---------- data (too big for git; rebuilt by scripts/generate_data.py) ----------
data/
*.tsv
*.csv
*.csv.gz

# dbt seeds ARE small and must be committed (exception to *.csv above)
!godesi/seeds/*.csv
!dashboard/streamlit/marts/*.csv
# ---------- secrets: never commit ----------
profiles.yml
# the GitHub Actions profile is the one exception: it holds only env_var() calls, no secrets
!ci/profiles.yml
.env
*.p8
*.pem
*.key
rsa_key*

# ---------- python ----------
.venv/
.venv-app/
venv/
__pycache__/


# ---------- dbt ----------
target/
dbt_packages/
logs/
.user.yml
# production manifest downloaded by slim CI
prod_state/

# ---------- editor and OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db